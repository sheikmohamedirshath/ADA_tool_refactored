# Copy this file to .env and keep only the connection string you want to use.

# Option 1: local SQLEXPRESS with SQL login
# MSSQL_CONN_STR=Driver={ODBC Driver 18 for SQL Server};Server=localhost\SQLEXPRESS;Database=ADA_DB;Uid=ada_user;Pwd=AdaTool@123;Encrypt=no;TrustServerCertificate=yes;

# Option 2: local SQLEXPRESS with Windows auth
# MSSQL_CONN_STR=Driver={ODBC Driver 18 for SQL Server};Server=localhost\SQLEXPRESS;Database=ADA_DB;Trusted_Connection=yes;Encrypt=no;TrustServerCertificate=yes;

MSSQL_DATABASE=ADA_DB
